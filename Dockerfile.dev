FROM node:24-alpine

RUN apk add --no-cache python3 build-base

RUN mkdir -p /home/node/app/node_modules && chown -R node:node /home/node/app

WORKDIR /home/node/app

COPY package*.json ./

USER node

# node_modules compiled for Linux (Alpine)
RUN npm ci

# src/, tsconfig.json, swisseph_files/ are bind-mounted at runtime
# (see docker-compose.dev.yml)

CMD ["npm", "run", "dev"]
