{
  "name": "ephemerides",
  "version": "1.0.0",
  "description": "Express API wrapping the Swiss Ephemeris library for planetary positions, houses, and transit aspects.",
  "scripts": {
    "build": "npx tsc",
    "start": "node build/index.js",
    "dev": "npx nodemon",
    "test": "node --require ts-node/register --test src/**/*.test.ts",
    "docker:build": "docker build -t ephemerides .",
    "docker:run": "docker run --rm -p 3601:3601 ephemerides"
  },
  "author": "Petr Kratochvíl",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.16",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sweph": "^2.10.3-3"
  }
}
