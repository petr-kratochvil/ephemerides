{
  "name": "ephemerides",
  "version": "1.0.0",
  "description": "Express API wrapping the Swiss Ephemeris library for planetary positions, houses, and transit aspects.",
  "author": "Petr Kratochvíl",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "nodemon",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t ephemerides .",
    "docker:run": "docker run --rm -p 3601:3601 ephemerides",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:reset": "docker compose -f docker-compose.dev.yml down -v"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "nodemon": "^3.0.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "sweph": "^2.10.3-3",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "sweph@2.10.3-3": true
  }
}
